{
  "schema": "openstitch-compat/1",
  "id": "spiral-rect40x30",
  "area": "stitches",
  "title": "Spiral Stitch: Shapes > Rectangle, defaults",
  "description": "PE-DESIGN 11.50's Spiral Stitch: one path from the start point on the outline, the outline offset a row (1 / density) inwards per turn to the middle (turns 0.5 mm apart on both axes of the rectangle), 4·2^n needle points a smooth turn, corners kept on a rectangle.",
  "covers": {
    "audit": [],
    "featureMatrix": [
      {
        "area": "Region sew types",
        "feature": "Concentric circle"
      }
    ]
  },
  "evidence": [
    {
      "kind": "measured",
      "note": "compat/reference/stitches/spiral-rect40x30.pes (PE-DESIGN 11.50, 2026-10-29, pe-refs-4): 39,90 x 29,70 mm, 1290 stitches"
    }
  ],
  "script": [
    {
      "command": "design.new",
      "params": {
        "width": 100,
        "height": 100
      }
    },
    {
      "command": "shape.rectangle",
      "params": {
        "x": 30,
        "y": 35,
        "width": 40,
        "height": 30
      }
    },
    {
      "command": "object.setRegion",
      "params": {
        "id": 1,
        "type": "spiral",
        "color": "Red"
      }
    },
    {
      "command": "object.setLine",
      "params": {
        "id": 1,
        "type": "none"
      }
    }
  ],
  "exports": [
    {
      "path": "region.pes"
    }
  ],
  "references": [
    {
      "id": "pe-design",
      "file": "stitches/spiral-rect40x30.pes",
      "make": "Shapes > Rectangle dragged (30,35)-(70,65) mm; region Spiral Stitch, every attribute at its default. Design Settings Hoop Size 100 x 100 mm (multi-needle machine type); line Not Sewn (Line); colour 800 EMBROIDERY RED (PEC 5); nothing else in the design. Region sew attributes of both Concentric Circle Stitch and Spiral Stitch: only Density (default 2,0 line/mm), Run pitch (default 2,0 mm) and Start Point (two buttons, default the first); no direction, under sewing or pull compensation. Defaults reset between variants. Save As PES (default type, #PES0110). Status bar 39,90 x 29,70 mm, Stitches = 1290."
    }
  ],
  "measurements": [
    {
      "id": "stitches",
      "measure": {
        "kind": "stitchCount"
      },
      "source": {
        "export": "region.pes"
      },
      "evidence": "PE-DESIGN 11.50's file: 1290 stitches; OpenStitch within 3 %",
      "reference": {
        "tolerance": {
          "percent": 3
        }
      }
    },
    {
      "id": "bounds-width",
      "measure": {
        "kind": "bounds",
        "property": "width"
      },
      "source": {
        "export": "region.pes"
      },
      "evidence": "PE-DESIGN 11.50's file",
      "reference": {
        "tolerance": {
          "mm": 0.35
        }
      }
    },
    {
      "id": "bounds-height",
      "measure": {
        "kind": "bounds",
        "property": "height"
      },
      "source": {
        "export": "region.pes"
      },
      "evidence": "PE-DESIGN 11.50's file",
      "reference": {
        "tolerance": {
          "mm": 0.35
        }
      }
    },
    {
      "id": "stitch-length-mean",
      "measure": {
        "kind": "stitchLength",
        "stat": "mean",
        "minLength": 0.3
      },
      "source": {
        "export": "region.pes"
      },
      "evidence": "PE-DESIGN 11.50's file",
      "reference": {
        "tolerance": {
          "mm": 0.15
        }
      }
    },
    {
      "id": "stitch-length-max",
      "measure": {
        "kind": "stitchLength",
        "stat": "max"
      },
      "source": {
        "export": "region.pes"
      },
