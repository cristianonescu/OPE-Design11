{
  "schema": "openstitch-compat/1",
  "id": "fill-frequency-default",
  "area": "stitches",
  "title": "Fill without Frequency keeps the ⅓ stagger",
  "description": "A 40 × 40 mm fill at 0° with 4 mm stitches: each row's needle points are shifted from the previous row's by the Frequency (as a share of the stitch length), ±2 % of the stitch length. Without a Frequency the old ⅓ stagger stays, so existing designs sew as before.",
  "covers": {
    "audit": [
      15
    ],
    "featureMatrix": [
      {
        "area": "Region sew types",
        "feature": "Fill (tatami: angle or auto direction"
      }
    ]
  },
  "evidence": [
    {
      "kind": "audit",
      "note": "docs/COMPATIBILITY_AUDIT.md item 15"
    },
    {
      "kind": "guide",
      "url": "https://support.brother.com/g/s/hf/htmldoc/ped/im/ped11/en/PED11_EN/pages/16_1293518.html",
      "note": "Frequency 0–50 %"
    }
  ],
  "script": [
    {
      "command": "design.new",
      "params": {
        "width": 100,
        "height": 100
      }
    },
    {
      "command": "shape.rectangle",
      "params": {
        "x": 10,
        "y": 10,
        "width": 40,
        "height": 40
      }
    },
    {
      "command": "object.setRegion",
      "params": {
        "id": 1,
        "type": "fill",
        "angle": 0,
        "stitchLength": 4
      }
    },
    {
      "command": "object.setLine",
      "params": {
        "id": 1,
        "type": "none"
      }
    }
  ],
  "exports": [
    {
      "path": "fill.pes"
    }
  ],
  "measurements": [
    {
      "id": "row-shift",
      "measure": {
        "kind": "rowShift",
        "stitchLength": 4,
        "interior": [
          10,
          50
        ]
      },
      "source": {
        "export": "fill.pes"
      },
      "expected": 1.3333,
      "tolerance": {
        "mm": 0.08,
        "modulo": 4
      },
      "evidence": "audit item 15: shift = frequency ±2 % of the stitch length"
    },
    {
      "id": "rows",
      "measure": {
        "kind": "stitchCount"
      },
      "source": {
        "export": "fill.pes"
      },
      "expected": {
        "min": 200
      },
      "evidence": "region_compat: more than 50 rows of needle points"
    }
  ]
}
