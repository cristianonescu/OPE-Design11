{
  "schema": "openstitch-compat/1",
  "id": "run-circle-60",
  "area": "stitches",
  "title": "A 60 mm circle sewn as running stitch at the default 2 mm pitch",
  "description": "PE-DESIGN's Ellipse tool circle of about 60 mm with line Running Stitch at its defaults (run pitch 2.0 mm, run times 1), region Not Sewn: 133 stitches. Issue #121: the running stitch on a Bezier circle samples each quarter arc by halving its parameter until the chord fits the pitch (satin-fit circle rule, text-fit-default); this pins it on a plain 60 mm circle. The circle's needle count and stitch lengths are compared.",
  "covers": {
    "audit": [],
    "featureMatrix": [
      {
        "area": "Line sew types",
        "feature": "Running (pitch, run times 1"
      }
    ]
  },
  "evidence": [
    {
      "kind": "measured",
      "note": "compat/reference/stitches/run-circle-60.pes (PE-DESIGN 11.50, 2026-10-29): 59.9 x 60.4 mm, 133 stitches (the Size dialog re-rounds the stitched extent: 60 typed in gives 59.6, then 59.9 x 60.4)"
    }
  ],
  "script": [
    {
      "command": "design.new",
      "params": {
        "width": 100,
        "height": 100
      }
    },
    {
      "command": "shape.ellipse",
      "params": {
        "cx": 40,
        "cy": 40.2,
        "rx": 29.95,
        "ry": 30.2,
        "outline": "Red"
      }
    },
    {
      "command": "object.setLine",
      "params": {
        "ids": [
          1
        ],
        "type": "running",
        "color": "Red",
        "pitch": 2.0,
        "runTimes": 1
      }
    }
  ],
  "exports": [
    {
      "path": "line.pes"
    }
  ],
  "references": [
    {
      "id": "pe-design",
      "file": "stitches/run-circle-60.pes",
      "make": "Shapes > Rectangle/Circle/Arc > Ellipse dragged (10, 10)-(70, 70) mm; Shapes tab line Running Stitch (Run pitch 2.0, Run time(s) 1), region Not Sewn (Region), 800 RED; Home > Size... to 60 mm (it settles at 59.9 x 60.4). Save As PES (default type)."
    }
  ],
  "measurements": [
    {
      "id": "stitches",
      "measure": {
        "kind": "stitchCount"
      },
      "source": {
        "export": "line.pes"
      },
      "evidence": "PE-DESIGN reference",
      "reference": {
        "tolerance": {
          "percent": 5
        }
      }
    },
    {
