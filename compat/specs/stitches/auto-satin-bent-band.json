{
  "schema": "openstitch-compat/1",
  "id": "auto-satin-bent-band",
  "area": "stitches",
  "title": "Auto direction satin follows a bent band",
  "description": "A 5 mm band bent through 90° and sewn in satin with Auto direction must turn its rows with the band: at five stations along the middle line, every stitch crossing within 0.3 mm is within 10° of perpendicular to the band, and no stitch is longer than the band is wide plus the slant.",
  "covers": {
    "audit": [
      7
    ],
    "featureMatrix": [
      {
        "area": "Editing",
        "feature": "Thread colour, sew type, straight sewing direction"
      },
      {
        "area": "Region sew types",
        "feature": "Satin: a zigzag across the column"
      }
    ]
  },
  "evidence": [
    {
      "kind": "audit",
      "note": "docs/COMPATIBILITY_AUDIT.md item 7"
    },
    {
      "kind": "guide",
      "url": "https://support.brother.com/g/s/hf/htmldoc/ped/im/ped11/en/PED11_EN/pages/16_1293518.html",
      "note": "Auto varies the direction to follow the shape"
    }
  ],
  "script": [
    {
      "command": "design.new",
      "params": {
        "width": 100,
        "height": 100
      }
    },
    {
      "command": "shape.polygon",
      "params": {
        "points": [
          [
            0,
            0
          ],
          [
            30,
            0
          ],
          [
            30,
            30
          ],
          [
            25,
            30
          ],
          [
            25,
            5
          ],
          [
            0,
            5
          ]
        ]
      }
    },
    {
      "command": "object.setRegion",
      "params": {
        "id": 1,
        "type": "satin",
        "autoDirection": true
      }
    }
  ],
  "exports": [
    {
      "path": "band.pes"
    }
  ],
  "references": [
    {
      "id": "pe-design",
      "file": "stitches/auto-satin-bent-band.pes",
      "make": "On a 100 × 100 mm Design Page draw the closed polygon (0,0) (30,0) (30,30) (25,30) (25,5) (0,5) mm (a 5 mm band bent through 90°). Line sewing off; region sew type Satin Stitch with Direction set to Auto, other attributes default. Save with Save As as PES (PE-DESIGN 11's default PES version) under the file name given, and record the PE-DESIGN version, the date, the operating system and every setting you changed in compat/reference/MANIFEST.json (see docs/COMPATIBILITY_TESTS.md)."
    }
  ],
  "measurements": [
    {
      "id": "off-perpendicular",
      "measure": {
        "kind": "angleOffPerpendicular",
        "stations": [
          {
            "at": [
              5,
              2.5
            ],
            "axis": [
              1,
              0
            ]
          },
          {
            "at": [
              12,
              2.5
            ],
            "axis": [
              1,
              0
            ]
          },
          {
            "at": [
              19,
              2.5
            ],
            "axis": [
              1,
              0
            ]
          },
          {
            "at": [
              27.5,
              13
            ],
            "axis": [
              0,
              1
            ]
          },
          {
            "at": [
              27.5,
              22
            ],
            "axis": [
              0,
              1
            ]
          }
        ],
        "radius": 0.3,
        "minLength": 1.0
      },
      "source": {
        "export": "band.pes",
        "align": {
          "anchor": "boundsMin",
          "to": [
            0,
            0
          ]
        }
      },
      "expected": {
        "max": 10
      },
      "evidence": "audit item 7: within ±10° of perpendicular at 5 stations",
      "reference": {
        "tolerance": {
          "deg": 5
        }
      }
    },
    {
      "id": "longest-stitch",
      "measure": {
        "kind": "stitchLength",
        "stat": "max"
      },
      "source": {
        "export": "band.pes",
        "align": {
          "anchor": "boundsMin",
          "to": [
            0,
            0
          ]
        }
      },
      "expected": {
        "max": 7.5
      },
      "evidence": "satin_compat::auto_direction_satin_follows_a_bent_band: rows stay across the 5 mm band"
    },
    {
      "id": "stitches",
      "measure": {
        "kind": "stitchCount"
      },
      "source": {
        "export": "band.pes",
        "align": {
          "anchor": "boundsMin",
          "to": [
            0,
            0
          ]
        }
      },
      "evidence": "PE-DESIGN 11 output of the same band",
      "reference": {
        "tolerance": {
          "percent": 15
        }
      }
    }
  ]
}
