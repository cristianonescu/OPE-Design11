{
  "schema": "openstitch-compat/1",
  "id": "satin-zigzag-rect",
  "area": "stitches",
  "title": "Region satin is a zigzag across the column",
  "description": "A 5 × 2 mm column sewn in satin at density 3 must be a zigzag: the needle goes across the column on every stitch, alternating between the two long edges, with no short stitch along an edge (the old square wave doubled the stitch count and perforated both edges).",
  "covers": {
    "audit": [
      1
    ],
    "featureMatrix": [
      {
        "area": "Region sew types",
        "feature": "Satin: a zigzag across the column"
      }
    ]
  },
  "evidence": [
    {
      "kind": "audit",
      "note": "docs/COMPATIBILITY_AUDIT.md item 1 (Defect: a square wave is wrong regardless of PE-DESIGN)"
    },
    {
      "kind": "guide",
      "url": "https://support.brother.com/g/s/hf/htmldoc/ped/im/ped11/en/PED11_EN/pages/16_1293518.html",
      "note": "Region sewing attributes: satin is shown only in pictures"
    }
  ],
  "script": [
    {
      "command": "design.new",
      "params": {
        "width": 100,
        "height": 100
      }
    },
    {
      "command": "shape.rectangle",
      "params": {
        "x": 10,
        "y": 10,
        "width": 5,
        "height": 2
      }
    },
    {
      "command": "object.setRegion",
      "params": {
        "id": 1,
        "type": "satin",
        "angle": 90,
        "density": 3
      }
    }
  ],
  "exports": [
    {
      "path": "satin.pes"
    }
  ],
  "references": [
    {
      "id": "pe-design",
      "file": "stitches/satin-zigzag-rect.pes",
      "make": "In Layout & Editing, on a 100 × 100 mm Design Page, draw a rectangle 5 mm wide and 2 mm high with its top-left corner at (10, 10) mm. Line sewing off; region sew type Satin Stitch, Direction 90°, Density 3.0 lines/mm, every other attribute at its default (note under sewing and pull compensation in the manifest). Save with Save As as PES (PE-DESIGN 11's default PES version) under the file name given, and record the PE-DESIGN version, the date, the operating system and every setting you changed in compat/reference/MANIFEST.json (see docs/COMPATIBILITY_TESTS.md)."
    }
  ],
  "machine": {
    "record": "stitches/satin-zigzag-rect.json",
    "make": "Sew target/compat/work/satin-zigzag-rect/satin.pes on a Brother machine on medium-weight woven cotton with tear-away stabiliser; look for needle holes or ragged thread along the two long edges (there should be none) and record the result."
  },
