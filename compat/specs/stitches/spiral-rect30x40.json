      "params": {
        "x": 35,
        "y": 30,
        "width": 30,
        "height": 40
      }
    },
    {
      "command": "object.setRegion",
      "params": {
        "id": 1,
        "type": "spiral",
        "color": "Red"
      }
    },
    {
      "command": "object.setLine",
      "params": {
        "id": 1,
        "type": "none"
      }
    }
  ],
  "exports": [
    {
      "path": "region.pes"
    }
  ],
  "references": [
