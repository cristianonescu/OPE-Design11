{
  "schema": "openstitch-compat/1",
  "id": "spiral-rect30x40",
  "area": "stitches",
  "title": "Spiral Stitch: Rectangle, round 5",
  "description": "PE-DESIGN 11.50's Spiral Stitch: the outline offset a row (1 / density) inwards per turn. Round 5 settles the winding and the end: from a start point on an outline vertex (circle, ellipse, triangle corner) the spiral turns counter-clockwise and ends in the middle; from a start point inside an edge (a rectangle's bottom middle) it runs clockwise to the next corner, spirals from there and, after a trim, returns to that corner and runs back to the start. PE: starts at the bottom-middle and ends at the same point; runs left.",
  "covers": {
    "audit": [],
    "featureMatrix": [
      {
        "area": "Region sew types",
        "feature": "Concentric circle"
      }
    ]
  },
  "evidence": [
    {
      "kind": "measured",
      "note": "compat/reference/stitches/spiral-rect30x40.pes (PE-DESIGN 11.50, 2026-10-30, pe-refs-4 round 5): 29,90 x 39,70 mm, 1286 st"
    }
  ],
  "script": [
