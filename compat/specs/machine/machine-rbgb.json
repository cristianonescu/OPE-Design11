{
  "schema": "openstitch-compat/1",
  "id": "machine-rbgb",
  "area": "machine",
  "title": "Same colours merge in first-occurrence order across another colour",
  "description": "Four 10 x 10 mm fill squares drawn red, blue, green, blue: PE-DESIGN sews red, then both blues as one block (a trim between them), then green: two colour changes.",
  "covers": {
    "audit": [
      16
    ],
