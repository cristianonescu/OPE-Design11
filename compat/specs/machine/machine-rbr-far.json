{
  "schema": "openstitch-compat/1",
  "id": "machine-rbr-far",
  "area": "machine",
  "title": "Same-colour objects 70 mm apart still sew as one block",
  "description": "Three 10 x 10 mm fill squares drawn red, blue, red with the reds 70 mm apart: PE-DESIGN sews both reds first (one block with a 61 mm trimmed move between them), then blue: one colour change.",
