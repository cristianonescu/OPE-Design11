  ],
  "exports": [
    {
      "path": "a.pes"
    }
  ],
  "references": [
    {
      "id": "pe-design",
      "file": "machine/machine-rbr-far.pes",
      "make": "Import an SVG (100 x 100 mm) with three 10 x 10 mm squares at x = 10 (red), 45 (blue), 80 (red) mm, y = 10 mm, as Fill Stitch at PE-DESIGN's import defaults; change nothing. Save with Save As as PES (PE-DESIGN 11's default PES version) under the file name given, and record the PE-DESIGN version, the date, the operating system and every setting you changed in compat/reference/MANIFEST.json (see docs/COMPATIBILITY_TESTS.md)."
    }
  ],
