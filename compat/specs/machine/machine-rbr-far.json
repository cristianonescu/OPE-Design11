    },
    {
      "command": "shape.rectangle",
      "params": {
        "x": 45,
        "y": 10,
        "width": 10,
        "height": 10,
        "fill": "Blue"
      }
    },
    {
      "command": "shape.rectangle",
      "params": {
        "x": 80,
        "y": 10,
        "width": 10,
        "height": 10,
        "fill": "Red"
      }
    },
    {
      "command": "object.setRegion",
      "params": {
        "ids": [
          1,
          3
        ],
        "type": "fill",
        "color": "Red",
        "angle": 45,
        "underlay": true
      }
    },
    {
      "command": "object.setRegion",
      "params": {
        "ids": [
          2
        ],
        "type": "fill",
        "color": "Blue",
        "angle": 45,
        "underlay": true
      }
    },
    {
      "command": "order.optimize",
      "params": {}
