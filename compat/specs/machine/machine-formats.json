{
  "schema": "openstitch-compat/1",
  "id": "machine-formats",
  "area": "machine",
  "title": "Machine formats carry the same stitches, trims and colour stops as PE-DESIGN 11's exports",
  "description": "One small design with every machine-level event: a trim inside a colour (two Red running lines 40 mm apart), a colour change (Black after Red), and 15 mm satin stitches that DST (12.1 mm), EXP and JEF (12.7 mm) must split. PE-DESIGN 11 opens OpenStitch's a.pes as stitches and exports it to each format; the exports are compared record by record with OpenStitch's own writers: jumps written for a trim, colour-stop records, the per-format stitch-length split and the header fields.",
  "covers": {
    "audit": [],
    "featureMatrix": [
      {
        "area": "Files",
        "feature": "DST read/write, configurable jumps-for-trim"
      },
      {
        "area": "Files",
        "feature": "EXP read/write"
      },
      {
        "area": "Files",
        "feature": "JEF read/write (Janome chart, stops, hoop code)"
      },
      {
        "area": "Files",
        "feature": "XXX read/write"
      },
      {
        "area": "Files",
        "feature": "PCS read/write (1/6 mm grid, hoop byte)"
      },
      {
        "area": "Files",
        "feature": "SEW read/write (Janome SEW chart)"
      },
      {
        "area": "Files",
        "feature": "HUS read and write (LZ77 + Huffman streams, HUS chart)"
      },
      {
        "area": "Files",
        "feature": "VIP read and write (HUS streams, obfuscated RGB colour table)"
      }
    ]
  },
  "evidence": [
    {
      "kind": "measured",
      "note": "PE-DESIGN 11.50 PES files (177 files, compat/reference and the owner's round-2 folders, 2026-10-27): every interior frame move carries the PEC trim flag; plain jumps appear only as the first record and right after a colour change; no zero-length stitch record"
    },
    {
      "kind": "spec",
      "url": "https://edutechwiki.unige.ch/en/Embroidery_format_DST",
      "note": "DST: 3-byte records, jump flag, colour change 0xC3; a trim is a run of jumps (count is a machine setting)"
    }
  ],
  "script": [
    {
      "command": "design.new",
      "params": {
        "name": "machine-formats",
        "width": 100,
        "height": 100
      }
    },
    {
      "command": "shape.polygon",
      "params": {
        "points": [
          [
            20,
            20
          ],
          [
            60,
            20
          ]
        ],
        "closed": false,
        "outline": "Red"
      }
    },
    {
      "command": "shape.polygon",
      "params": {
        "points": [
          [
            20,
            60
          ],
          [
            60,
            60
          ]
        ],
        "closed": false,
        "outline": "Red"
      }
    },
    {
      "command": "object.setLine",
      "params": {
        "ids": [
          1,
          2
        ],
        "type": "running",
        "color": "Red",
        "pitch": 2.5,
        "runTimes": 1
      }
    },
    {
      "command": "shape.rectangle",
      "params": {
        "x": 20,
        "y": 30,
        "width": 40,
        "height": 15,
        "fill": "Black"
      }
    },
    {
      "command": "object.setRegion",
      "params": {
        "id": 3,
        "type": "satin",
        "color": "Black",
        "angle": 90,
        "density": 4.5,
        "underlay": false
      }
    }
  ],
  "exports": [
    {
      "path": "a.pes"
    },
    {
      "path": "a.dst"
    },
    {
      "path": "a.exp"
    },
    {
      "path": "a.jef"
    },
    {
      "path": "a.pcs"
    },
    {
      "path": "a.sew"
    },
    {
      "path": "a.xxx"
    },
    {
      "path": "a.hus"
    },
    {
      "path": "a.vip"
    }
  ],
  "references": [
    {
      "id": "pe-design-dst",
      "file": "machine/machine-formats.dst",
      "make": "Run `stitchtool compat --only machine-formats` and open target/compat/work/machine-formats/a.pes in PE-DESIGN 11 (two Red running lines (20,20)-(60,20) and (20,60)-(60,60) mm with a trim between them, then a Black satin rectangle (20,30)-(60,45) mm with 15 mm stitches across it). Change nothing. File > Export (or Save As with the other-format type list) as Tajima DST under the file name given; record every option PE-DESIGN offers for the export (for DST: the number of jumps for a trim) and its value, the PE-DESIGN version, the date and the operating system in compat/reference/MANIFEST.json."
    },
    {
      "id": "pe-design-exp",
      "file": "machine/machine-formats.exp",
      "make": "As for the DST reference, exported as Melco EXP."
    },
    {
      "id": "pe-design-jef",
      "file": "machine/machine-formats.jef",
      "make": "As for the DST reference, exported as Janome JEF."
    },
    {
      "id": "pe-design-pcs",
      "file": "machine/machine-formats.pcs",
      "make": "As for the DST reference, exported as Pfaff PCS."
    },
    {
      "id": "pe-design-sew",
      "file": "machine/machine-formats.sew",
      "make": "As for the DST reference, exported as Janome SEW."
    },
    {
      "id": "pe-design-xxx",
      "file": "machine/machine-formats.xxx",
      "make": "As for the DST reference, exported as Singer XXX."
    },
    {
      "id": "pe-design-hus",
      "file": "machine/machine-formats.hus",
      "make": "As for the DST reference, exported as Husqvarna Viking HUS."
    },
    {
      "id": "pe-design-vip",
      "file": "machine/machine-formats.vip",
      "make": "As for the DST reference, exported as Pfaff / Husqvarna Viking VIP."
    }
  ],
  "machine": {
    "record": "machine/machine-formats.json",
    "make": "Sew target/compat/work/machine-formats/a.pes on a Brother single-needle machine (medium-weight woven cotton, tear-away stabiliser): the two Red lines must sew with one thread cut between them (no thread span across the 40 mm gap), the machine must stop once for Black, and the satin must sew its 15 mm stitches whole with no needle holes along the long edges. Record the result, the cut, and whether the machine showed the design as 40 x 40 mm."
  },
  "measurements": [
    {
      "id": "trim",
      "measure": {
        "kind": "interiorMoves",
        "command": "trim"
      },
      "source": {
        "export": "a.pes"
      },
      "expected": 1,
      "evidence": "the 40 mm move between the two Red lines is the only trim; the colour change carries its own cut"
    },
    {
      "id": "colour-change",
      "measure": {
        "kind": "commandCount",
        "command": "colorChange"
      },
      "source": {
        "export": "a.pes"
      },
      "expected": 1,
      "evidence": "Red then Black"
    },
    {
      "id": "satin-kept-whole",
      "measure": {
        "kind": "stitchLength",
        "stat": "max"
      },
      "source": {
        "export": "a.pes"
      },
      "expected": 15.0,
      "tolerance": {
        "mm": 0.2
      },
      "evidence": "PE-DESIGN 11 keeps satin stitches whole in PES up to 15 mm (stitch-sweeps S8, sweep-satin-width-15.pes); the machine formats split them at their own limits"
    },
    {
