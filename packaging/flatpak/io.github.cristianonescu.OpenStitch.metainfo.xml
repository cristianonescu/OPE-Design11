<component type="desktop-application">
  <id>io.github.cristianonescu.OpenStitch</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>OpenStitch</name>
  <summary>Create and edit machine embroidery designs</summary>
  <developer id="io.github.cristianonescu">
    <name>OpenStitch contributors</name>
  </developer>
  <description>
    <p>
      OpenStitch is an independent embroidery design editor. It draws shapes and lettering,
      turns them into running, satin and fill stitches, simulates the sew-out and writes
      machine files such as PES and DST.
    </p>
    <p>
      Designs are saved as open .osd projects; PES and other machine files can be opened and
      imported.
    </p>
  </description>
  <launchable type="desktop-id">io.github.cristianonescu.OpenStitch.desktop</launchable>
