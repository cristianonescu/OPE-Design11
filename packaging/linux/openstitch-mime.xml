<?xml version="1.0" encoding="UTF-8"?>
<!-- Shared MIME types for OpenStitch projects and PES embroidery files. -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-openstitch-design">
    <comment>OpenStitch design</comment>
    <sub-class-of type="application/json"/>
    <icon name="openstitch"/>
    <glob pattern="*.osd"/>
  </mime-type>
  <mime-type type="application/x-pes-embroidery">
    <comment>PES embroidery file</comment>
    <magic priority="50">
      <match type="string" offset="0" value="#PES"/>
    </magic>
    <glob pattern="*.pes"/>
  </mime-type>
</mime-info>
